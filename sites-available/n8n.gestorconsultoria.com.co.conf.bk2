    server {
	server_name n8n.gestorconsultoria.com.co;
	location / {
	    proxy_pass http://10.0.0.5:8032;
	    proxy_redirect off;
	    # proxy_set_header Host $host;
	    # proxy_set_header X-Real-IP $remote_addr;
	    # add_header 'Content-Security-Policy' 'upgrade-insecure-requests';
	#return 301 https://aserprem.com.co$request_uri;

        #proxy_pass http://localhost:5678;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;




    }


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/n8n.gestorconsultoria.com.co/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/n8n.gestorconsultoria.com.co/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
    server {
    if ($host = n8n.gestorconsultoria.com.co) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


	server_name n8n.gestorconsultoria.com.co;


    listen 80;
    return 404; # managed by Certbot


}
