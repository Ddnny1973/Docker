xserver {
    server_name www.gestorconsultoria.com.co gestorconsultoria.com.co;
    location / {
        proxy_pass http://192.168.120.13:80;
        proxy_redirect off;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
    }


    listen 80; # managed by Certbot

}
