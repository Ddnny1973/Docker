# =============================================================================
# 40 — OpenClaw (asistente personal). Variables de entorno.
#
# Copiar y completar EN EL SERVIDOR; NUNCA commitear este archivo:
#     cd /data/odoo/40 && cp .env.example .env && chmod 600 .env
# =============================================================================

# Token de autenticación del Gateway de OpenClaw (Control UI / WebSocket).
# Generarlo en el servidor:  openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Token del bot de Telegram (BotFather). Se lee POR ENV (no va en openclaw.json).
TELEGRAM_BOT_TOKEN=

# Zona horaria del contenedor.
OPENCLAW_TZ=America/Bogota

# ---- Proveedor de modelo LLM (PENDIENTE de elección) ----
# No bloquea el arranque ni Telegram: el chat necesita el modelo activo.
# Se configura en fase 2 vía `openclaw auth` en el servidor cuando se elija.
# Candidatos usados/probados en este repo:
#   - Z.ai (GLM)  — provider de la instalación previa de 40 (nunca desplegada).
#   - OpenAI / Anthropic.
# Descomentar la clave del proveedor elegido cuando exista.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#ZAI_API_KEY=